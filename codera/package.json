{
  "name": "codera",
  "version": "0.1.0",
  "private": true,
  "description": "Codera — منصّة SaaS وايت-ليبل لمتاجر الملابس مع تجربة لبس افتراضية بالذكاء الاصطناعي",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "seed": "node --experimental-sqlite src/db/seed.js",
    "reset": "rm -f data/codera.db && node --experimental-sqlite src/db/seed.js",
    "test": "node --experimental-sqlite --test"
  },
  "dependencies": {}
}
