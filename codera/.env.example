# ---- Codera configuration ----
PORT=3000
# Domain used for tenant subdomains, e.g. store1.codera.app
BASE_DOMAIN=lvh.me
# Secret used to sign session cookies (change in production)
SESSION_SECRET=change-me-in-production

# ---- AI Virtual Try-On provider ----
# Options: mock | fashn | replicate
AI_PROVIDER=mock
FASHN_API_KEY=
REPLICATE_API_TOKEN=
# Replicate model version for garment try-on (e.g. IDM-VTON)
REPLICATE_TRYON_VERSION=

# ---- Shopify import (per-tenant tokens are stored in DB; these are fallbacks) ----
SHOPIFY_API_VERSION=2024-10

# ---- Billing (UPayment) ----
UPAYMENT_API_URL=https://sandboxapi.upayments.com/api/v1
UPAYMENT_API_KEY=
UPAYMENT_MERCHANT_ID=
BILLING_CURRENCY=SAR
